  {"name": "metric_type", "type": "STRING", "mode": "NULLABLE", "description": "error_rate, p99_latency_ms, cpu_percent, request_rate"},
  {"name": "value", "type": "FLOAT64", "mode": "NULLABLE", "description": "Metric value"},

  {"name": "incident_id", "type": "STRING", "mode": "NULLABLE", "description": "UUID for incident events"},
